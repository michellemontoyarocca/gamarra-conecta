@startuml
title Gamarra Conecta - Flujo DevSecOps y despliegue automático
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #D97706
}
start
:Plan - historia GC-n con criterios de aceptacion en Jira;
:Code - rama feature/GC-n creada desde test;
:Commit con la clave y el nombre exacto de la historia;
:Push a GitHub dispara el workflow "CI, seguridad y despliegue";
partition "Job calidad (GitHub Actions, ubuntu-latest)" {
  :Checkout del codigo;
  :Preparar Python 3.12;
  :Instalar requirements.txt + Bandit + pip-audit + detect-secrets;
  :Build: python -m compileall;
  :Test: python -m unittest discover (54 pruebas);
  :SAST: bandit -r app.py -ll;
  :Dependencias: pip-audit -r requirements.txt;
  :Secretos: detect-secrets scan --all-files;
  :Guardar reportes de los tres escaneos como artefacto;
}
if (¿Todos los pasos en verde?) then (si)
  :Merge de la rama feature en test (--no-ff);
  :Pull Request test -> main;
  :Revision y merge en main;
  partition "Job deploy (main + calidad aprobada)" {
    :SSH con clave limitada al script de despliegue;
    :Respaldar SQLite y actualizar main;
    :Instalar dependencias y reiniciar el servicio;
    :Comprobar /salud; restaurar commit anterior si falla;
  }
  :Despliegue verificado en https://gamarra.comextech.es;
  :Operar: logs de systemd y respaldo diario de SQLite;
  :Monitor: prueba de humo en /salud;
else (no)
  :Corregir el hallazgo o la prueba\ny repetir el pipeline;
endif
stop
note right
  Los reportes de seguridad quedan disponibles
  como artefactos de cada ejecucion de CI.
end note
@enduml
