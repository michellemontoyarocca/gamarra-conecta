@startuml
title Gamarra Conecta - Arquitectura logica implementada (UML componentes)
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle uml2
skinparam ArrowColor #334155
skinparam component {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
}
skinparam database {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
  FontColor #0F172A
}
actor "Visitante / Comerciante /\nAdministrador" as U
package "Presentacion" {
  [Navegador y plantillas Jinja2\n(base, index, directorio, ficha,\nguia, orientacion, admin)] as UI
}
package "Aplicacion - Flask (app.py)" {
  [Rutas web\n/ /negocios /negocios/<id> /guia\n/registro /login /logout\n/mi-negocio /orientacion /admin /salud] as API
  [Autenticacion, sesion y CSRF\n(login_required, admin_required)] as Auth
  [Negocios y directorio\n(perfil, filtros, ficha publica)] as Biz
  [Solicitudes de orientacion] as Req
  [Moderacion y panel admin\n(publicar, rechazar, revisar)] as Admin
}
package "Datos" {
  database "SQLite\ninstance/gamarra.sqlite3\n(users, businesses,\nguidance_requests)" as DB
}
package "Tecnologia (VPS)" {
  [Nginx con HTTPS\n(Let's Encrypt)] as Proxy
  [Gunicorn\n127.0.0.1:8018] as WSGI
}
cloud "Fuentes oficiales\n(enlaces externos)" as EXT
U --> UI : interaccion
UI --> Proxy : HTTPS 443
Proxy --> WSGI : HTTP interno
WSGI --> API
API --> Auth
API --> Biz
API --> Req
API --> Admin
Auth --> DB : consultas parametrizadas
Biz --> DB : lectura y escritura
Req --> DB : lectura y escritura
Admin --> DB : actualiza estados
UI ..> EXT : enlaces de la guia
@enduml
