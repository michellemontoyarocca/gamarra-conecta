@startuml
title Gamarra Conecta - Solicitud de orientacion (UML secuencia, HU08)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #334155
skinparam ParticipantBorderColor #2563EB
skinparam ParticipantBackgroundColor #EFF6FF
skinparam SequenceLifeLineBorderColor #94A3B8
skinparam SequenceGroupBorderColor #94A3B8
actor Comerciante
participant "Navegador" as N
participant "Ruta /orientacion\n(Flask)" as F
participant "Control de sesion\ny CSRF" as A
database "SQLite" as DB
Comerciante -> N : completa tema y detalle
N -> F : POST /orientacion + token CSRF
F -> A : verificar token CSRF
alt token ausente o invalido
  A --> F : rechazo
  F --> N : 400 Bad Request
else token valido
  F -> A : verificar sesion (login_required)
  alt sin sesion
    A --> F : usuario anonimo
    F --> N : 302 redireccion a /login
  else sesion valida
    A --> F : usuario autenticado
    F -> F : validar tema (lista cerrada)\ny detalle (1 a 1000 caracteres)
    alt datos invalidos
      F --> N : mensaje de error, sin guardar
    else datos validos
      F -> DB : INSERT guidance_requests\n(user_id, topic, details, estado pendiente)
      DB --> F : fila creada
      F --> N : redireccion a /orientacion
      N --> Comerciante : "Solicitud registrada" con estado pendiente
    end
  end
end
@enduml
