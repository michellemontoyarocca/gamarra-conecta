@startuml
title Gamarra Conecta - Diagrama de casos de uso (implementado)
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #334155
skinparam usecase {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
}
skinparam actor {
  BorderColor #0F172A
  FontColor #0F172A
}
actor "Visitante" as VIS
actor "Comerciante" as COM
actor "Administrador" as ADM
rectangle "Sistema Gamarra Conecta" {
  usecase "Consultar directorio\n(HU04)" as UC1
  usecase "Filtrar por rubro\no nombre (HU05)" as UC2
  usecase "Abrir ficha de\nun negocio (HU06)" as UC11
  usecase "Consultar guia de\nformalizacion (HU07)" as UC6
  usecase "Crear cuenta (HU01)" as UC3
  usecase "Iniciar y cerrar\nsesion (HU02)" as UC4
  usecase "Registrar y editar\nnegocio (HU03)" as UC5
  usecase "Solicitar orientacion\n(HU08)" as UC7
  usecase "Consultar estado de\nmis solicitudes (HU09)" as UC12
  usecase "Aprobar o rechazar\nperfiles (HU10)" as UC10
  usecase "Marcar solicitudes\ncomo revisadas" as UC8
  usecase "Consultar indicadores" as UC9
}
VIS --> UC1
VIS --> UC11
VIS --> UC6
VIS --> UC3
COM --> UC4
COM --> UC5
COM --> UC7
COM --> UC12
ADM --> UC4
ADM --> UC10
ADM --> UC8
ADM --> UC9
UC2 ..> UC1 : <<extend>>
UC11 ..> UC1 : <<extend>>
UC5 ..> UC4 : <<include>>
UC7 ..> UC4 : <<include>>
UC12 ..> UC4 : <<include>>
UC10 ..> UC4 : <<include>>
UC8 ..> UC4 : <<include>>
UC9 ..> UC4 : <<include>>
note bottom of UC6
  Contenido informativo con enlaces a SUNAT,
  Municipalidad de La Victoria y gob.pe.
  No equivale a una evaluacion legal.
end note
@enduml
