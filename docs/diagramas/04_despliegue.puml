@startuml
title Gamarra Conecta - Diagrama de despliegue (VPS en produccion)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #334155
skinparam node {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
  FontColor #0F172A
}
skinparam artifact {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
node "Dispositivo del usuario" as client {
  artifact "Navegador web" as browser
}
cloud "DNS\ngamarra.comextech.es\nregistro A -> 76.13.8.33" as dns
node "VPS Ubuntu (76.13.8.33)\nIaaS - recursos dedicados al VPS" as vps {
  node "Nginx\npuertos 80 y 443\ncertificado Let's Encrypt (Certbot)" as nginx
  node "systemd: gamarra-conecta.service\nusuario sin privilegios: gamarra" as svc {
    artifact "Gunicorn 2 workers\n127.0.0.1:8018" as gunicorn
    artifact "Aplicacion Flask\n/srv/gamarra-conecta" as flask
  }
  database "SQLite\n/srv/gamarra-conecta/instance" as db
  artifact "Variables de entorno\n/etc/gamarra-conecta.env\n(GAMARRA_ENV, GAMARRA_SECRET_KEY)" as env
  artifact "Respaldos diarios 03:30\n/srv/gamarra-backups\n(14 dias)" as bk
  node "Otras aplicaciones del VPS\n(Esparragos, etc.), sin cambios" as otras
}
cloud "GitHub\nmichellemontoyarocca/gamarra-conecta\n(repositorio publico + Actions)" as github
browser --> dns : resuelve nombre
browser --> nginx : HTTPS 443
nginx --> gunicorn : proxy_pass local
gunicorn --> flask
flask --> db : lectura y escritura
svc ..> env : EnvironmentFile
db --> bk : copia con sqlite3.backup
github ..> flask : git clone / git pull (despliegue manual por SSH)
nginx ..> otras : otros server_name, independientes
@enduml
